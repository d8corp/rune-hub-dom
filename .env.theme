RD_THEME__PREFIX='rd_'
RD_THEME__ROOT='*{-webkit-tap-highlight-color:transparent;box-sizing:border-box}::-webkit-scrollbar{height:8px;width:8px}::-webkit-scrollbar-track{background:light-dark(#fff,#0b0b15)}::-webkit-scrollbar-thumb{--proximity-x:calc(var(--cursor-x, -999px) - var(--proximity-x-offset, 0px));--proximity-y:calc(var(--cursor-y, -999px) - var(--proximity-y-offset, 0px));background:rgba(139,92,246,.149) radial-gradient(circle 100px at var(--proximity-x) var(--proximity-y),light-dark(#7c3aed,#8b5cf6) 0,light-dark(#7c3aed,#8b5cf6) 30%,transparent 100%) fixed;border-radius:4px;cursor:grab;transition:background-color .2s}::-webkit-scrollbar-thumb:active{cursor:grabbing}::-webkit-scrollbar-thumb:hover{background-color:light-dark(#7c3aed,#8b5cf6)}@property --rd-glow-x-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-y-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-padding{syntax:"<length-percentage>+";initial-value:1px;inherits:false}@property --rd-glow-bg{syntax:"<color>";initial-value:light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));inherits:true}@property --rd-glow-color{syntax:"<color>";initial-value:light-dark(#7c3aed,#8b5cf6);inherits:true}@media (hover:hover) and (pointer:fine){@supports (mask-composite:exclude){[data-glow]{--rd-glow-x:calc(var(--cursor-x, -999px) - var(--rd-glow-x-offset, 0px));--rd-glow-y:calc(var(--cursor-y, -999px) - var(--rd-glow-y-offset, 0px));border:none!important;position:var(--rd-position)}[data-glow]:before{background:var(--rd-glow-bg) radial-gradient(circle 100px at var(--rd-glow-x) var(--rd-glow-y),light-dark(#7c3aed,#8b5cf6) 0,light-dark(#7c3aed,#8b5cf6) 30%,transparent 100%) fixed;border-radius:inherit;content:"";display:block;inset:0;-webkit-mask-clip:content-box,padding-box;mask-clip:content-box,padding-box;-webkit-mask-composite:xor;mask-composite:exclude;-webkit-mask-image:linear-gradient(#fff,#fff),linear-gradient(#fff,#fff);mask-image:linear-gradient(#fff,#fff),linear-gradient(#000,#000);padding:var(--rd-glow-padding);pointer-events:none;position:absolute}}}@keyframes spin{0%{opacity:0}to{opacity:1}}body,html{font-family:SF Pro Display,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;line-height:1.6;margin:0;min-height:100vh;padding:0}body{background:var(--color-bg);color:light-dark(#1e1b2e,#f1f5f9);display:flex;flex-direction:column;overflow-x:hidden}::view-transition-group(messages){z-index:3}@property --message-progress{syntax:"<angle>";inherits:false;initial-value:0deg}@keyframes message-time{0%{--message-progress:0deg}to{--message-progress:360deg}}@keyframes show-message{0%{filter:blur(8px);opacity:0;top:-20px}}@keyframes hide-message{0%{filter:blur(0);opacity:1;top:0}to{filter:blur(8px);opacity:0;top:10px}}::view-transition-group(.rd_message_1){z-index:3}::view-transition-group(.rd_message_2){z-index:2}::view-transition-group(.rd_message_3){z-index:1}::view-transition-old(.rd_message):only-child{animation:hide-message .2s ease both}::view-transition-new(.rd_message):only-child{animation:show-message .2s ease both}@keyframes spin-rotate{0%{animation-timing-function:cubic-bezier(.6,.1,.1,.6);transform:rotate(0deg)}to{transform:rotate(1turn)}}@keyframes spin-fade{0%{animation-timing-function:cubic-bezier(.6,.1,.1,.6);opacity:0}50%{animation-timing-function:cubic-bezier(.6,.1,.1,.6);opacity:var(--spin-dot-opacity)}to{opacity:0}}@keyframes zoom-show{0%{opacity:0;transform:scale(0)}to{opacity:1;transform:scale(1)}}@keyframes zoom-hide{0%{opacity:1;transform:scale(1)}to{opacity:0;transform:scale(0)}}@keyframes fade-in-up{0%{filter:blur(8px);opacity:0;top:100px}to{filter:blur(0);opacity:1;top:0}}@keyframes fade-in-down{0%{filter:blur(0);opacity:1;top:0}to{filter:blur(8px);opacity:0;top:100px}}::view-transition-group(devtools-button),::view-transition-group(devtools-window){z-index:1}::view-transition-old(devtools-button):only-child{animation:zoom-hide .2s ease both}::view-transition-new(devtools-button):only-child{animation:zoom-show .2s ease both}::view-transition-old(devtools-window):only-child{animation:fade-in-down .2s ease both;backdrop-filter:blur(0)}::view-transition-new(devtools-window):only-child{animation:fade-in-up .2s ease both;backdrop-filter:blur(4px)}'
RD_THEME_FLEX='.rd_flex{display:flex}'
RD_THEME_LINK='.rd_link{color:light-dark(#7c3aed,#8b5cf6);text-decoration:none;transition:color .2s}.rd_link:hover{color:light-dark(#8b5cf6,#a78bfa)}.rd_link:focus-visible{outline:none;text-decoration:underline}'
RD_THEME_DIVIDER='.rd_divider{align-self:stretch;border:0 solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122))}.rd_divider:not(.rd_divider_vertical){border-bottom-width:var(--rd-divider-size);margin:0 4px}.rd_divider_vertical{border-left-width:var(--rd-divider-size);margin:4px 0}.rd_divider_s{--rd-divider-size:1px}.rd_divider_m{--rd-divider-size:2px}.rd_divider_l{--rd-divider-size:3px}'
RD_THEME_INLINE='.rd_inline{border-radius:9999px;color:light-dark(#fff,#000);transition:all .2s}.rd_inline:has(>svg:first-child){padding-left:0}.rd_inline:has(>svg:last-child){padding-right:0}.rd_inline_primary{background:light-dark(#7c3aed,#8b5cf6)}.rd_inline_accent{background:light-dark(#db2777,#f472b6)}.rd_inline_secondary{background:rgba(139,92,246,.078)}.rd_inline_success{background:light-dark(#059669,#34d399)}.rd_inline_warning{background:light-dark(#ea580c,#fb923c)}.rd_inline_danger{background:light-dark(#e11d48,#fb7185)}.rd_inline_disabled{background:light-dark(#8b85a0,#64748b);cursor:default}.rd_inline_s{font-size:6px;height:8px;min-height:8px;min-width:8px;padding:0}.rd_inline_s.rd_inline_square{border-radius:2px}.rd_inline_m{font-size:10px;height:12px;min-height:12px;min-width:12px;padding:1px}.rd_inline_m.rd_inline_square{border-radius:4px}.rd_inline_l{font-size:12px;height:16px;min-height:16px;min-width:16px;padding:2px}.rd_inline_l.rd_inline_square{border-radius:5px}.rd_inline_clickable{cursor:pointer}@media (hover:hover) and (pointer:fine){.rd_inline_hoverable:not(:hover){color:transparent}}'
RD_THEME_BLOCK='.rd_block{--block-color:#fff;background-clip:border-box;border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));color:var(--block-color);font-weight:700;gap:8px;transition:all .2s}.rd_block:hover{--block-color:#fff;--rd-glow-bg:light-dark(rgba(124,58,237,.302),rgba(139,92,246,.302));border-color:light-dark(rgba(124,58,237,.302),rgba(139,92,246,.302))}.rd_block_l{border-radius:12px;font-size:16px;height:56px;min-height:56px;min-width:56px;padding:14px 28px}.rd_block_l.rd_block_square{padding:14px}.rd_block_m{border-radius:8px;font-size:14px;height:36px;min-height:36px;min-width:36px;padding:8px 16px}.rd_block_m.rd_block_square{padding:8px}.rd_block_s{border-radius:6px;font-size:10px;height:24px;min-height:24px;min-width:24px;padding:6px 8px}.rd_block_s.rd_block_square{padding:6px}.rd_block_primary{background:light-dark(#7c3aed,#8b5cf6)}.rd_block_accent{background:light-dark(#db2777,#f472b6)}.rd_block_secondary{--block-color:light-dark(#8b5cf6,#a78bfa);backdrop-filter:blur(4px);background:rgba(139,92,246,.078)}.rd_block_secondary:hover{background:rgba(139,92,246,.149);color:light-dark(#7c3aed,#fff)}.rd_block_success{background:light-dark(#059669,#34d399)}.rd_block_danger{background:light-dark(#e11d48,#fb7185)}.rd_block_warning{background:light-dark(#ea580c,#fb923c)}.rd_block_disabled{background:light-dark(#8b85a0,#64748b)}.rd_block_circle{border-radius:9999px}'
RD_THEME_BUTTON='.rd_button{align-items:center;cursor:pointer;display:inline-flex;justify-content:center;overflow:hidden;position:relative}.rd_button_loading,.rd_button_loading:hover{color:transparent}.rd_button_spin{color:var(--block-color);font-size:1.43em;left:50%;position:absolute;top:50%;transform:translate(-50%,-50%)}.rd_button_l>.rd_button_spin{font-size:28px}.rd_button_accent{background:linear-gradient(135deg,light-dark(#7c3aed,#8b5cf6),light-dark(#db2777,#f472b6)) 0 0/100% 100%;border:none}.rd_button_accent:hover{background:linear-gradient(135deg,light-dark(#7c3aed,#8b5cf6),light-dark(#db2777,#f472b6)) 0 0/200% 200%;color:#fff}.rd_button_secondary:after{background:linear-gradient(135deg,transparent,light-dark(rgba(124,58,237,.102),hsla(0,0%,100%,.102)),transparent);border-radius:inherit;content:"";inset:0;pointer-events:none;position:absolute;transform:translateX(-100%)}.rd_button_secondary:hover:after{transform:translateX(100%);transition:transform .3s}.rd_button_secondary:active{background:rgba(116,66,229,.3)}'
RD_THEME_CODE='.rd_code{border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:4px;color:light-dark(#8b5cf6,#a78bfa);cursor:pointer;font-size:.8em;padding:2px 4px}.rd_code,.rd_code:after{background:rgba(139,92,246,.078)}.rd_code:after{border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:5px;content:"copied";display:block;opacity:0;padding:4px 8px;pointer-events:none;position:absolute;transform:translateX(-50%) translateY(-100%);transition:opacity .2s,transform .2s}.rd_code_copied:after{opacity:1;transform:translateX(-50%) translateY(-130%)}'
RD_THEME_WINDOW='.rd_window{background:light-dark(#d9d1f6,#332958);border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:16px;gap:8px;padding:8px}'
RD_THEME_WINDOW_HEADER='.rd_window-header{align-items:center;color:light-dark(#5b556e,#94a3b8);font-size:12px;gap:8px}'
RD_THEME_WINDOW_CONTENT='.rd_window-content{background:light-dark(#f1edfc,#1a1a2e);border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:8px;flex:1;font-size:14px;gap:8px;min-height:0;padding:8px}'
RD_THEME_TYPOGRAPHY='.rd_typography>:first-child{margin-top:0}.rd_typography>:last-child{margin-bottom:0}'
RD_THEME_FIELD='.rd_field{align-items:center;justify-content:center}.rd_field:focus-visible{background:red}'
RD_THEME_INPUT='.rd_input{cursor:text}.rd_input_clear{cursor:pointer}.rd_input_secondary:has(.rd_input_input:focus){background:rgba(139,92,246,.149);border-color:rgba(139,92,246,.149)}.rd_input_input{background:transparent;border:none;flex:1;min-width:0}.rd_input_input:focus{outline:none}'
