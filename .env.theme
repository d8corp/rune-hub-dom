RD_THEME_MESSAGES='.rd_messages{view-transition-name:messages;align-items:center;display:flex;font-size:12px;height:1px;justify-content:center;perspective:250px;pointer-events:none;position:fixed;right:30%;top:4px;transform-origin:top center;width:40%;z-index:3}@media (max-width:1024px){.rd_messages{right:14px;width:calc(100% - 28px)}}.rd_messages:hover .rd_message_timeout:before{animation-play-state:paused}'
RD_THEME_MESSAGE='.rd_message{view-transition-class:rd_message rd_message_1;align-items:center;border:1px solid rgba(0,0,0,.2);border-radius:24px;color:#fff;cursor:pointer;display:flex;gap:8px;opacity:1;overflow:hidden;padding:6px 20px;pointer-events:all;position:absolute;text-align:center;top:10px;user-select:none;width:auto;z-index:3}.rd_message~.rd_message{pointer-events:none}.rd_message+.rd_message{view-transition-class:rd_message rd_message_2;top:5px;transform:translateZ(-100px);z-index:2}.rd_message+.rd_message+.rd_message{view-transition-class:rd_message rd_message_3;top:0;transform:translateZ(-200px);z-index:1}.rd_message+.rd_message+.rd_message~.rd_message{display:none}.rd_message_success{background-color:light-dark(#059669,#34d399)}.rd_message_error{background-color:light-dark(#e11d48,#fb7185)}.rd_message_warning{background-color:light-dark(#ea580c,#fb923c)}.rd_message_info{background-color:light-dark(#7c3aed,#8b5cf6)}.rd_message_timeout{padding-left:12px}.rd_message_timeout:before{background:conic-gradient(#fff var(--message-progress),hsla(0,0%,100%,.267) 0);border-radius:50%;content:"";display:block;height:14px;-webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 3px));mask:radial-gradient(farthest-side,transparent calc(100% - 3px),#000 calc(100% - 3px));width:14px}.rd_message:first-child:before{animation:message-time linear both;animation-duration:var(--rd-message-timeout)}'
RD_THEME_MESSAGE__1='rd_message_1'
RD_THEME_MESSAGE__2='rd_message_2'
RD_THEME_MESSAGE__3='rd_message_3'
