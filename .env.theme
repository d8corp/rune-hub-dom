RD_THEME_DEVTOOLS_WINDOW='@media (hover:hover) and (pointer:fine){@supports (mask-composite:exclude){.rd_devtools-window{--rd-glow-x:calc(var(--cursor-x, -999px) - var(--rd-glow-x-offset, 0px));--rd-glow-y:calc(var(--cursor-y, -999px) - var(--rd-glow-y-offset, 0px));border:none!important;position:var(--rd-position)}.rd_devtools-window:before{background:var(--rd-glow-bg) radial-gradient(circle 100px at var(--rd-glow-x) var(--rd-glow-y),light-dark(#7c3aed,#8b5cf6) 0,light-dark(#7c3aed,#8b5cf6) 30%,transparent 100%) fixed;border-radius:inherit;content:"";display:block;inset:0;-webkit-mask-clip:content-box,padding-box;mask-clip:content-box,padding-box;-webkit-mask-composite:xor;mask-composite:exclude;-webkit-mask-image:linear-gradient(#fff,#fff),linear-gradient(#fff,#fff);mask-image:linear-gradient(#fff,#fff),linear-gradient(#000,#000);padding:var(--rd-glow-padding);pointer-events:none;position:absolute}}}.rd_devtools-window{--rd-position:fixed;view-transition-name:devtools-window;bottom:10px;height:50vh;left:10px;position:fixed;right:10px;transition:opacity .2s,margin .2s;z-index:999999}.rd_devtools-window_filter{display:flex;gap:8px}.rd_devtools-window_content{display:flex;flex:1;flex-direction:column;gap:8px;min-height:0;min-width:0}.rd_devtools-window_list{display:flex;flex:1;flex-direction:column;overflow:auto;overscroll-behavior:contain;padding-right:8px}.rd_devtools-window_virtual-list{display:flex;flex-direction:column;gap:4px}.rd_devtools-window_aside{display:flex;flex-direction:column;gap:8px;width:300px}.rd_devtools-window_aside-header{display:flex;gap:8px}.rd_devtools-window_filter-button{border:none;cursor:pointer}.rd_devtools-window_filter-on-button{background:green}.rd_devtools-window_filter-off-button{background:red}'
