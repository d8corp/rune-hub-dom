RD_THEME_DEVTOOLS_SLOT_PANEL='.rd_devtools-slot-panel{display:flex;flex:1;flex-direction:column;min-height:0;min-width:0}.rd_devtools-slot-panel_content{overflow:auto}.rd_devtools-slot-panel_code-block,.rd_devtools-slot-panel_content{display:flex;flex-direction:column}.rd_devtools-slot-panel_code{background:var(--rd-color-bg-contrast);border:1px solid var(--rd--secondary-border);border-radius:4px;flex:1;min-height:fit-content;padding:4px}'