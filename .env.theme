RD_THEME_BOX='.rd_box{--box-second-color:#fff;align-items:center;background:transparent;font-size:var(--box-font-size);justify-content:center;min-height:var(--box-size);min-width:var(--box-size);transition:all .2s}.rd_box_clickable{cursor:pointer;user-select:none}.rd_box_filled{background-color:var(--box-main-color);border:1px solid var(--box-main-color);color:var(--box-second-color)}.rd_box_bordered{background-color:var(--box-light-color);border:1px solid var(--box-border-color,var(--box-main-color));color:var(--box-main-color)}.rd_box_dashed{background-color:transparent;border:1px dashed var(--box-border-color);color:var(--box-main-color)}@media (hover:hover) and (pointer:fine){.rd_box_dashed:is(.rd_box_hoverable,.rd_box_clickable):hover{border-color:var(--box-main-color)}}.rd_box_ghost{border:1px solid transparent;color:var(--box-main-color)}@media (hover:hover) and (pointer:fine){.rd_box_ghost:is(.rd_box_hoverable,.rd_box_clickable):hover{background-color:var(--box-light-color)}}.rd_box_primary{--box-main-color:light-dark(#8b5cf6,#8b5cf6);--box-light-color:light-dark(#f2ebff,#2c1358);--box-border-color:light-dark(#ccaffd,#5921ba)}@media (hover:hover) and (pointer:fine){.rd_box_primary:is(.rd_box_hoverable,.rd_box_clickable):hover{--box-main-color:light-dark(#7c3aed,#a06cf9);--box-light-color:light-dark(#e8dcff,#3b1877);--box-border-color:light-dark(#ac7efb,#6724db)}.rd_box_primary:is(.rd_box_hoverable,.rd_box_clickable):hover.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}}.rd_box_primary.rd_box_clickable:active{--box-main-color:light-dark(#5921ba,#7c3aed);--box-light-color:light-dark(#dcc8fe,#5921ba)}.rd_box_primary.rd_box_clickable:active.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}.rd_box_secondary{--box-main-color:light-dark(#828282,#828282);--box-light-color:light-dark(#efefef,#272727);--box-border-color:light-dark(silver,#515151)}@media (hover:hover) and (pointer:fine){.rd_box_secondary:is(.rd_box_hoverable,.rd_box_clickable):hover{--box-main-color:light-dark(#6f6f6f,#8f8f8f);--box-light-color:light-dark(#e3e3e3,#343434);--box-border-color:light-dark(#9c9c9c,#5e5e5e)}.rd_box_secondary:is(.rd_box_hoverable,.rd_box_clickable):hover.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}}.rd_box_secondary.rd_box_clickable:active{--box-main-color:light-dark(#515151,#6f6f6f);--box-light-color:light-dark(#d3d3d3,#515151)}.rd_box_secondary.rd_box_clickable:active.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}.rd_box_accent{--box-main-color:light-dark(#db2777,#f472b6);--box-light-color:light-dark(#feecf4,#500b28);--box-border-color:light-dark(#ffbada,#a70256)}@media (hover:hover) and (pointer:fine){.rd_box_accent:is(.rd_box_hoverable,.rd_box_clickable):hover{--box-main-color:light-dark(#c20164,#fa81bf);--box-light-color:light-dark(#ffdfed,#6b0b37);--box-border-color:light-dark(#fc90c6,#c20164)}.rd_box_accent:is(.rd_box_hoverable,.rd_box_clickable):hover.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}}.rd_box_accent.rd_box_clickable:active{--box-main-color:light-dark(#a70256,#db2777);--box-light-color:light-dark(#ffcfe4,#a70256)}.rd_box_accent.rd_box_clickable:active.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}.rd_box_success{--box-main-color:#059669;--box-light-color:light-dark(#e8f7ef,#033423);--box-border-color:light-dark(#a9e9ca,#016d4b)}@media (hover:hover) and (pointer:fine){.rd_box_success:is(.rd_box_hoverable,.rd_box_clickable):hover{--box-main-color:light-dark(#008059,#31b987);--box-light-color:light-dark(#d8f4e6,#00472f);--box-border-color:light-dark(#6cdead,#008059)}.rd_box_success:is(.rd_box_hoverable,.rd_box_clickable):hover.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}}.rd_box_success.rd_box_clickable:active{--box-main-color:light-dark(#016d4b,#008059);--box-light-color:light-dark(#c4efd9,#016d4b)}.rd_box_success.rd_box_clickable:active.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}.rd_box_danger{--box-main-color:#e11d48;--box-light-color:light-dark(#ffeced,#520816);--box-border-color:light-dark(#febdc2,#a90130)}@media (hover:hover) and (pointer:fine){.rd_box_danger:is(.rd_box_hoverable,.rd_box_clickable):hover{--box-main-color:light-dark(#c50039,#f1576d);--box-light-color:light-dark(#ffe0e2,#6f061e);--box-border-color:light-dark(#ff939f,#c50039)}.rd_box_danger:is(.rd_box_hoverable,.rd_box_clickable):hover.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}}.rd_box_danger.rd_box_clickable:active{--box-main-color:light-dark(#a90130,#c50039);--box-light-color:light-dark(#ffd1d4,#a90130)}.rd_box_danger.rd_box_clickable:active.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}.rd_box_warning{--box-main-color:#ea580c;--box-light-color:light-dark(#feefe6,#531b02);--box-border-color:light-dark(#ffcaa5,#ac3d01)}@media (hover:hover) and (pointer:fine){.rd_box_warning:is(.rd_box_hoverable,.rd_box_clickable):hover{--box-main-color:light-dark(#c94800,#f57c30);--box-light-color:light-dark(#ffe6d5,#702500);--box-border-color:light-dark(#ffaa6c,#c94800)}.rd_box_warning:is(.rd_box_hoverable,.rd_box_clickable):hover.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}}.rd_box_warning.rd_box_clickable:active{--box-main-color:light-dark(#ac3d01,#c94800);--box-light-color:light-dark(#ffd9c0,#ac3d01)}.rd_box_warning.rd_box_clickable:active.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}.rd_box_disabled{--box-main-color:light-dark(#8b85a0,#64748b);--box-light-color:light-dark(#f0eff3,#222831);--box-border-color:light-dark(#c4c1d0,#475467)}@media (hover:hover) and (pointer:fine){.rd_box_disabled:is(.rd_box_hoverable,.rd_box_clickable):hover{--box-main-color:light-dark(#7a7f98,#7a7f98);--box-light-color:light-dark(#e4e3ea,#2e3643);--box-border-color:light-dark(#a39eb5,#536379)}.rd_box_disabled:is(.rd_box_hoverable,.rd_box_clickable):hover.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}}.rd_box_disabled.rd_box_clickable:active{--box-main-color:light-dark(#64748b,#536379);--box-light-color:light-dark(#d6d4de,#475467)}.rd_box_disabled.rd_box_clickable:active.rd_box_bordered{color:light-dark(var(--box-main-color),#fff)}.rd_box_xxs{--box-size:8px;--box-font-size:4px;border-radius:2px}.rd_box_xs{--box-size:12px;--box-font-size:6px;border-radius:4px}.rd_box_s{--box-size:16px;--box-font-size:7px;border-radius:5px;padding:0 1px}.rd_box_m{--box-size:24px;--box-font-size:10px;border-radius:6px;padding:0 8px}.rd_box_m.rd_box_square{padding:0 6px}.rd_box_m.rd_box_square-left{padding-left:6px}.rd_box_m.rd_box_square-right{padding-right:6px}.rd_box_l{--box-size:36px;--box-font-size:14px;border-radius:8px;padding:0 16px}.rd_box_l.rd_box_square{padding:0 8px}.rd_box_l.rd_box_square-left{padding-left:8px}.rd_box_l.rd_box_square-right{padding-right:8px}.rd_box_xl{--box-size:56px;--box-font-size:16px;border-radius:12px;padding:0 28px}.rd_box_xl.rd_box_square{padding:0 14px}.rd_box_xl.rd_box_square-left{padding-left:14px}.rd_box_xl.rd_box_square-right{padding-right:14px}.rd_box_xxl{--box-size:64px;--box-font-size:18px;border-radius:12px;padding:0 28px}.rd_box_xxl.rd_box_square{padding:0 14px}.rd_box_xxl.rd_box_square-left{padding-left:14px}.rd_box_xxl.rd_box_square-right{padding-right:14px}.rd_box_circle{border-radius:9999px}'
RD_THEME_BOX__CLICKABLE='rd_box_clickable'
RD_THEME_BOX__FILLED='rd_box_filled'
RD_THEME_BOX__BORDERED='rd_box_bordered'
