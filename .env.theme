RD_THEME_BOX__SQUARE_RIGHT='rd_box_square-right'
RD_THEME_BOX__XL='rd_box_xl'
RD_THEME_BOX__XXL='rd_box_xxl'
RD_THEME_BUTTON__BORDERED='rd_button_bordered'
RD_THEME_BUTTON__HOVERABLE='rd_button_hoverable'
