RD_THEME_DEVTOOLS_SLOT_ITEM='.rd_devtools-slot-item{align-items:center;border:1px solid transparent;border-radius:6px;cursor:pointer;display:flex;font-size:14px;gap:8px;height:34px;padding:6px 10px;transition:background-color .2s ease,border-color .2s ease}.rd_devtools-slot-item:hover,.rd_devtools-slot-item_selected{background:var(--rd--alpha-color)}.rd_devtools-slot-item_selected{border-color:var(--rd--secondary-border)}.rd_devtools-slot-item_value{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}'
