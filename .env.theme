RD_THEME_CHECK_BOX__ROOT='rd_check-box'
RD_THEME_CHECK_BOX__INDETERMINATE='rd_check-box_indeterminate'
RD_THEME_CHECK_BOX__INPUT='rd_check-box_input'
RD_THEME_RADIO_BOX__ROOT='rd_radio-box'
RD_THEME_RADIO_BOX__INPUT='rd_radio-box_input'
RD_THEME_CHECK_BOX='.rd_check-box{display:inline-flex;outline:1px solid transparent;outline-offset:2px}.rd_check-box:before{background:var(--box-main-color);background-image:url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="4" stroke="%23fff"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>');background-position:50%;background-repeat:no-repeat;background-size:1em;border-radius:50%;content:"";display:block;font-size:0;height:0;opacity:0;pointer-events:none;position:absolute;transition:all .2s;width:0}.rd_check-box_indeterminate:before{border-radius:2px;height:8px;opacity:1;width:8px}.rd_check-box:has(.rd_check-box_input:checked):before{border-radius:inherit;font-size:var(--box-font-size);height:var(--box-size);opacity:1;width:var(--box-size)}.rd_check-box:has(.rd_check-box_input:focus-visible){outline-color:var(--box-main-color)}.rd_check-box_input{cursor:inherit;opacity:0;position:absolute}'
RD_THEME_RADIO_BOX='.rd_radio-box{border-radius:9999px;display:inline-flex;outline:1px solid transparent;outline-offset:2px}.rd_radio-box:before{background:var(--box-main-color);border-radius:50%;content:"";display:block;height:0;opacity:0;pointer-events:none;position:absolute;transition:all .2s;width:0}.rd_radio-box:has(.rd_radio-box_input:checked):before{height:calc(var(--box-size)/2);opacity:1;width:calc(var(--box-size)/2)}.rd_radio-box:has(.rd_radio-box_input:focus-visible){outline-color:var(--box-main-color)}.rd_radio-box_input{cursor:inherit;opacity:0;position:absolute}'
RD_THEME_BOX__SECONDARY='rd_box_secondary'