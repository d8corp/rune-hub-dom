__ENV_EXTENDS=.env.theme
INNETJS_ENV_PREFIX=RD_
RD_PACKAGE_VERSION=${npm_package_version}
BUILD_TSCONFIG=tsconfig.build.json
RELEASE_TSCONFIG=tsconfig.release.json
BUILD_FOLDER=docs
BASE_URL=/rundom
RD_BASE_URL=/rundom
RD_VIEW_TRANSITION=true
RD_THEME__PREFIX=rd_
RD_THEME__SPIN_DOT_COUNT=6
RD_UI_CODE=@docs/theme/code
RD_UI_MESSAGE=@docs/theme/message
