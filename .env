BUILD_TSCONFIG=tsconfig.build.json
RELEASE_TSCONFIG=tsconfig.release.json
BUILD_FOLDER=docs
BASE_URL=/rundom
INNETJS_ENV_PREFIX=RD_
RD_THEME__PREFIX=
RD_THEME__ROOT='*{-webkit-tap-highlight-color:transparent;box-sizing:border-box}::-webkit-scrollbar{height:8px;width:8px}::-webkit-scrollbar-track{background:light-dark(#fff,#0b0b15)}::-webkit-scrollbar-thumb{--proximity-x:calc(var(--cursor-x, -999px) - var(--proximity-x-offset, 0px));--proximity-y:calc(var(--cursor-y, -999px) - var(--proximity-y-offset, 0px));background:rgba(139,92,246,.149) radial-gradient(circle 100px at var(--proximity-x) var(--proximity-y),light-dark(#7c3aed,#8b5cf6) 0,light-dark(#7c3aed,#8b5cf6) 30%,transparent 100%) fixed;border-radius:4px;cursor:grab;transition:background-color .2s}::-webkit-scrollbar-thumb:active{cursor:grabbing}::-webkit-scrollbar-thumb:hover{background-color:light-dark(#7c3aed,#8b5cf6)}@property --rd-glow-x-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-y-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-padding{syntax:"<length-percentage>+";initial-value:1px;inherits:false}@property --rd-glow-bg{syntax:"<color>";initial-value:light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));inherits:true}@property --rd-glow-color{syntax:"<color>";initial-value:light-dark(#7c3aed,#8b5cf6);inherits:true}@media (hover:hover) and (pointer:fine){@supports (mask-composite:exclude){[data-glow]{--rd-glow-x:calc(var(--cursor-x, -999px) - var(--rd-glow-x-offset, 0px));--rd-glow-y:calc(var(--cursor-y, -999px) - var(--rd-glow-y-offset, 0px));border:none!important;position:var(--rd-position)}[data-glow]:before{background:var(--rd-glow-bg) radial-gradient(circle 100px at var(--rd-glow-x) var(--rd-glow-y),light-dark(#7c3aed,#8b5cf6) 0,light-dark(#7c3aed,#8b5cf6) 30%,transparent 100%) fixed;border-radius:inherit;content:"";display:block;inset:0;-webkit-mask-clip:content-box,padding-box;mask-clip:content-box,padding-box;-webkit-mask-composite:xor;mask-composite:exclude;-webkit-mask-image:linear-gradient(#fff,#fff),linear-gradient(#fff,#fff);mask-image:linear-gradient(#fff,#fff),linear-gradient(#000,#000);padding:var(--rd-glow-padding);pointer-events:none;position:absolute}}}body,html{font-family:SF Pro Display,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;line-height:1.6;margin:0;min-height:100vh;padding:0;scroll-behavior:smooth;transition:background-color .2s}body{background:var(--color-bg);color:light-dark(#1e1b2e,#f1f5f9);display:flex;flex-direction:column;overflow-x:hidden}'
RD_THEME_FLEX='.flex{display:flex}'
RD_THEME_LINK='.link{color:light-dark(#7c3aed,#8b5cf6);text-decoration:none;transition:color .2s}.link:hover{color:light-dark(#8b5cf6,#a78bfa)}.link:focus-visible{outline:none;text-decoration:underline}'
RD_THEME_DIVIDER='.divider{align-self:stretch;border:0 solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122))}.divider:not(.divider_vertical){border-bottom-width:var(--rd-divider-size);margin:0 4px}.divider_vertical{border-left-width:var(--rd-divider-size);margin:4px 0}.divider_s{--rd-divider-size:1px}.divider_m{--rd-divider-size:2px}.divider_l{--rd-divider-size:3px}'
RD_THEME_INLINE='.inline{border-radius:9999px;color:light-dark(#fff,#000);transition:all .2s}.inline:has(>svg:first-child){padding-left:0}.inline:has(>svg:last-child){padding-right:0}.inline_primary{background:light-dark(#7c3aed,#8b5cf6)}.inline_accent{background:light-dark(#db2777,#f472b6)}.inline_secondary{background:rgba(139,92,246,.078)}.inline_success{background:light-dark(#059669,#34d399)}.inline_warning{background:light-dark(#ea580c,#fb923c)}.inline_danger{background:light-dark(#e11d48,#fb7185)}.inline_disabled{background:light-dark(#8b85a0,#64748b);cursor:default}.inline_s{font-size:6px;height:8px;min-height:8px;min-width:8px;padding:0}.inline_s.inline_square{border-radius:2px}.inline_m{font-size:10px;height:12px;min-height:12px;min-width:12px;padding:1px}.inline_m.inline_square{border-radius:4px}.inline_l{font-size:12px;height:16px;min-height:16px;min-width:16px;padding:2px}.inline_l.inline_square{border-radius:5px}.inline_clickable{cursor:pointer}@media (hover:hover) and (pointer:fine){.inline_hoverable:not(:hover){color:transparent}}'
RD_THEME_BLOCK='.block{background-clip:border-box;border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));color:#fff;font-weight:700;gap:8px;transition:all .2s}.block:hover{--rd-glow-bg:$color-border-hover;border-color:light-dark(rgba(124,58,237,.302),rgba(139,92,246,.302));color:#fff}.block_l{border-radius:12px;font-size:16px;height:56px;min-height:56px;min-width:56px;padding:14px 28px}.block_l.block_square{padding:14px}.block_m{border-radius:8px;font-size:14px;height:36px;min-height:36px;min-width:36px;padding:8px 16px}.block_m.block_square{padding:8px}.block_s{border-radius:6px;font-size:10px;height:24px;min-height:24px;min-width:24px;padding:6px 8px}.block_s.block_square{padding:6px}.block_primary{background:light-dark(#7c3aed,#8b5cf6);color:#fff}.block_accent{background:light-dark(#db2777,#f472b6)}.block_secondary{backdrop-filter:blur(4px);background:rgba(139,92,246,.078);color:light-dark(#8b5cf6,#a78bfa)}.block_secondary:hover{background:rgba(139,92,246,.149);color:light-dark(light-dark(#7c3aed,#8b5cf6),#fff)}.block_success{background:light-dark(#059669,#34d399)}.block_danger{background:light-dark(#e11d48,#fb7185)}.block_warning{background:light-dark(#ea580c,#fb923c)}.block_disabled{background:light-dark(#8b85a0,#64748b)}.block_circle{border-radius:9999px}'
RD_THEME_BUTTON='.button{align-items:center;cursor:pointer;display:inline-flex;justify-content:center;overflow:hidden;position:relative}.button_accent{background:linear-gradient(135deg,light-dark(#7c3aed,#8b5cf6),light-dark(#db2777,#f472b6)) 0 0/100% 100%;border:none}.button_accent:hover{background:linear-gradient(135deg,light-dark(#7c3aed,#8b5cf6),light-dark(#db2777,#f472b6)) 0 0/200% 200%}.button_secondary:after{background:linear-gradient(135deg,transparent,light-dark(rgba(124,58,237,.102),hsla(0,0%,100%,.102)),transparent);border-radius:inherit;content:"";inset:0;pointer-events:none;position:absolute;transform:translateX(-100%)}.button_secondary:hover:after{transform:translateX(100%);transition:transform .3s}.button_secondary:active{background:rgba(116,66,229,.3)}'
RD_THEME_CODE='.code{border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:4px;color:light-dark(#8b5cf6,#a78bfa);cursor:pointer;font-size:.8em;padding:2px 4px}.code,.code:after{background:rgba(139,92,246,.078)}.code:after{border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:5px;content:"copied";display:block;opacity:0;padding:4px 8px;pointer-events:none;position:absolute;transform:translateX(-50%) translateY(-100%);transition:opacity .2s,transform .2s}.code_copied:after{opacity:1;transform:translateX(-50%) translateY(-130%)}'
RD_THEME_WINDOW='.window{backdrop-filter:blur(8px);background:rgba(139,92,246,.078);border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:16px;gap:8px;padding:8px}'
RD_THEME_WINDOW_HEADER='.window-header{align-items:center;color:light-dark(#5b556e,#94a3b8);font-size:12px;gap:8px}'
RD_THEME_WINDOW_CONTENT='.window-content{background:light-dark(#f1edfc,#1a1a2e);border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:8px;flex:1;font-size:14px;gap:8px;min-height:0;padding:8px}'
RD_THEME_TYPOGRAPHY='.typography>:first-child{margin-top:0}.typography>:last-child{margin-bottom:0}'
RD_THEME_FIELD='.field{align-items:center;justify-content:center}.field:focus-visible{background:red}'
RD_THEME_INPUT='.input{cursor:text}.input_clear{cursor:pointer}.input_secondary:has(.input_input:focus){background:rgba(139,92,246,.149);border-color:rgba(139,92,246,.149)}.input_input{background:transparent;border:none;flex:1;min-width:0}.input_input:focus{outline:none}'