BUILD_TSCONFIG=tsconfig.build.json
RELEASE_TSCONFIG=tsconfig.release.json
BUILD_FOLDER=docs
BASE_URL=/rundom
INNETJS_ENV_PREFIX=RD_
RD_THEME_LINK='@property --rd-glow-x-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-y-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-padding{syntax:"<length-percentage>+";initial-value:1px;inherits:false}@property --rd-glow-bg{syntax:"<color>";initial-value:light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));inherits:true}@property --rd-glow-color{syntax:"<color>";initial-value:light-dark(#7c3aed,#8b5cf6);inherits:true}.rd_link{color:light-dark(#7c3aed,#8b5cf6);text-decoration:none;transition:color .2s}.rd_link:hover{color:light-dark(#8b5cf6,#a78bfa)}.rd_link:focus-visible{outline:none;text-decoration:underline}'
RD_THEME_BLOCK='@property --rd-glow-x-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-y-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-padding{syntax:"<length-percentage>+";initial-value:1px;inherits:false}@property --rd-glow-bg{syntax:"<color>";initial-value:light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));inherits:true}@property --rd-glow-color{syntax:"<color>";initial-value:light-dark(#7c3aed,#8b5cf6);inherits:true}.rd_block{background-clip:border-box;border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));color:#fff;font-weight:700;transition:all .2s}.rd_block:hover{--rd-glow-bg:$color-border-hover;border-color:light-dark(rgba(124,58,237,.302),rgba(139,92,246,.302));color:#fff}.rd_block__l{border-radius:12px;font-size:16px;height:56px;min-height:56px;min-width:56px;padding:14px 28px}.rd_block__l.rd_block__square{padding:14px}.rd_block__m{border-radius:8px;font-size:14px;height:36px;min-height:36px;min-width:36px;padding:8px 16px}.rd_block__m.rd_block__square{padding:8px}.rd_block__s{border-radius:6px;font-size:10px;height:24px;min-height:24px;min-width:24px;padding:6px 8px}.rd_block__s.rd_block__square{padding:6px}.rd_block__primary{background:light-dark(#7c3aed,#8b5cf6);color:#fff}.rd_block__accent{background:light-dark(#db2777,#f472b6)}.rd_block__secondary{backdrop-filter:blur(4px);background:rgba(139,92,246,.078);color:light-dark(#8b5cf6,#a78bfa)}.rd_block__secondary:hover{background:rgba(139,92,246,.149);color:light-dark(#7c3aed,#8b5cf6)}.rd_block__success{background:light-dark(#059669,#34d399)}.rd_block__danger{background:light-dark(#e11d48,#fb7185)}.rd_block__warning{background:light-dark(#ea580c,#fb923c)}.rd_block__disabled{background:light-dark(#8b85a0,#64748b)}'
RD_THEME_BUTTON='@property --rd-glow-x-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-y-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-padding{syntax:"<length-percentage>+";initial-value:1px;inherits:false}@property --rd-glow-bg{syntax:"<color>";initial-value:light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));inherits:true}@property --rd-glow-color{syntax:"<color>";initial-value:light-dark(#7c3aed,#8b5cf6);inherits:true}.rd_button{cursor:pointer;overflow:hidden;position:relative}.rd_button:after{background:linear-gradient(135deg,transparent,light-dark(rgba(124,58,237,.102),hsla(0,0%,100%,.102)),transparent);border-radius:inherit;content:"";inset:0;pointer-events:none;position:absolute;transform:translateX(-100%)}.rd_button:hover:after{transform:translateX(100%);transition:transform .3s}.rd_button__accent{background:linear-gradient(135deg,light-dark(#7c3aed,#8b5cf6),light-dark(#db2777,#f472b6)) 0 0/100% 100%;border:none}.rd_button__accent:hover{background:linear-gradient(135deg,light-dark(#7c3aed,#8b5cf6),light-dark(#db2777,#f472b6)) 0 0/200% 200%}'
RD_THEME_INLINE='@property --rd-glow-x-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-y-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-padding{syntax:"<length-percentage>+";initial-value:1px;inherits:false}@property --rd-glow-bg{syntax:"<color>";initial-value:light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));inherits:true}@property --rd-glow-color{syntax:"<color>";initial-value:light-dark(#7c3aed,#8b5cf6);inherits:true}.rd_inline{border-radius:9999px;color:light-dark(#fff,#000);transition:all .2s}.rd_inline:has(>svg:first-child){padding-left:0}.rd_inline:has(>svg:last-child){padding-right:0}.rd_inline__primary{background:light-dark(#7c3aed,#8b5cf6)}.rd_inline__accent{background:light-dark(#db2777,#f472b6)}.rd_inline__secondary{background:rgba(139,92,246,.078)}.rd_inline__success{background:light-dark(#059669,#34d399)}.rd_inline__warning{background:light-dark(#ea580c,#fb923c)}.rd_inline__danger{background:light-dark(#e11d48,#fb7185)}.rd_inline__disabled{background:light-dark(#8b85a0,#64748b);cursor:default}.rd_inline__s{font-size:6px;height:8px;min-height:8px;min-width:8px;padding:0}.rd_inline__s.rd_inline__square{border-radius:2px}.rd_inline__m{font-size:10px;height:12px;min-height:12px;min-width:12px;padding:1px}.rd_inline__m.rd_inline__square{border-radius:4px}.rd_inline__l{font-size:12px;height:16px;min-height:16px;min-width:16px;padding:2px}.rd_inline__l.rd_inline__square{border-radius:5px}.rd_inline__clickable{cursor:pointer}.rd_inline__pulse{animation:pulse 2s ease-in-out infinite;box-shadow:0 0 8px currentColor}@media (hover:hover) and (pointer:fine){.rd_inline__hoverable:not(:hover){color:transparent}}'
RD_THEME__ROOT='@keyframes pulse{50%{opacity:.6;transform:scale(.85)}}*{-webkit-tap-highlight-color:transparent;box-sizing:border-box}::-webkit-scrollbar{height:8px;width:8px}::-webkit-scrollbar-track{background:light-dark(#fff,#0b0b15)}::-webkit-scrollbar-thumb{--proximity-x:calc(var(--cursor-x, -999px) - var(--proximity-x-offset, 0px));--proximity-y:calc(var(--cursor-y, -999px) - var(--proximity-y-offset, 0px));background:rgba(139,92,246,.149) radial-gradient(circle 100px at var(--proximity-x) var(--proximity-y),light-dark(#7c3aed,#8b5cf6) 0,light-dark(#7c3aed,#8b5cf6) 30%,transparent 100%) fixed;border-radius:4px;cursor:grab;transition:background-color .2s}::-webkit-scrollbar-thumb:active{cursor:grabbing}::-webkit-scrollbar-thumb:hover{background-color:light-dark(#7c3aed,#8b5cf6)}@media (hover:hover) and (pointer:fine){@supports (mask-composite:exclude){[data-glow]{--rd-glow-x:calc(var(--cursor-x, -999px) - var(--rd-glow-x-offset, 0px));--rd-glow-y:calc(var(--cursor-y, -999px) - var(--rd-glow-y-offset, 0px));border:none!important;position:var(--rd-position)}[data-glow]:before{background:var(--rd-glow-bg) radial-gradient(circle 100px at var(--rd-glow-x) var(--rd-glow-y),var(--rd-glow-color) 0,var(--rd-glow-color) 30%,transparent 100%) fixed;border-radius:inherit;content:"";display:block;inset:0;-webkit-mask-clip:content-box,padding-box;mask-clip:content-box,padding-box;-webkit-mask-composite:xor;mask-composite:exclude;-webkit-mask-image:linear-gradient(#fff,#fff),linear-gradient(#fff,#fff);mask-image:linear-gradient(#fff,#fff),linear-gradient(#000,#000);padding:var(--rd-glow-padding);pointer-events:none;position:absolute}}}body,html{font-family:SF Pro Display,system-ui,-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;line-height:1.6;margin:0;min-height:100vh;padding:0;scroll-behavior:smooth;transition:background-color .2s}body{background:var(--color-bg);color:light-dark(#1e1b2e,#f1f5f9);display:flex;flex-direction:column;overflow-x:hidden}'
RD_THEME_DIVIDER='@property --rd-glow-x-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-y-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-padding{syntax:"<length-percentage>+";initial-value:1px;inherits:false}@property --rd-glow-bg{syntax:"<color>";initial-value:light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));inherits:true}@property --rd-glow-color{syntax:"<color>";initial-value:light-dark(#7c3aed,#8b5cf6);inherits:true}.rd_divider{align-self:stretch;border:0 solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122))}.rd_divider:not(.rd_divider__vertical){border-bottom-width:var(--rd-divider-size);margin:0 4px}.rd_divider__vertical{border-left-width:var(--rd-divider-size);margin:4px 0}.rd_divider__s{--rd-divider-size:1px}.rd_divider__m{--rd-divider-size:2px}.rd_divider__l{--rd-divider-size:3px}'
RD_THEME_CODE='@property --rd-glow-x-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-y-offset{syntax:"<length-percentage>";initial-value:0;inherits:true}@property --rd-glow-padding{syntax:"<length-percentage>+";initial-value:1px;inherits:false}@property --rd-glow-bg{syntax:"<color>";initial-value:light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));inherits:true}@property --rd-glow-color{syntax:"<color>";initial-value:light-dark(#7c3aed,#8b5cf6);inherits:true}.rd_code{backdrop-filter:blur(4px);border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:4px;color:light-dark(#8b5cf6,#a78bfa);cursor:pointer;font-size:.8em;padding:2px 8px}.rd_code,.rd_code:after{background:rgba(139,92,246,.078)}.rd_code:after{border:1px solid light-dark(rgba(124,58,237,.122),rgba(139,92,246,.122));border-radius:5px;content:"copied";display:block;opacity:0;padding:4px 8px;pointer-events:none;position:absolute;transform:translateX(-50%) translateY(-100%);transition:opacity .2s,transform .2s}.rd_code__copied:after{opacity:1;transform:translateX(-50%) translateY(-130%)}'