RD_THEME_SPIN='.rd_spin{--spin-duration:1.8s;stroke:none;fill:currentColor}.rd_spin_dot{--spin-dot-size:max(calc(3px - 0.01em),10%);--spin-dot-to:1.5625%;--spin-dot-from:calc(var(--spin-dot-size)/2);--spin-dot-count:calc(sibling-count() - 2);--spin-dot-index:calc(sibling-index() - 2);--spin-dot-offset:calc((var(--spin-dot-from) - var(--spin-dot-to))/var(--spin-dot-count));--spin-dot-opacity:calc(1 - var(--spin-dot-index)*(0.9/var(--spin-dot-count)));--spin-dot-delay-offset:calc(var(--spin-duration)/18);cx:50%;cy:var(--spin-dot-size);r:calc(var(--spin-dot-from) - var(--spin-dot-offset)*var(--spin-dot-index));animation:spin-rotate var(--spin-duration) infinite both,spin-fade var(--spin-duration) infinite both;animation-delay:calc(var(--spin-dot-index)*var(--spin-dot-delay-offset));transform-origin:50%}.rd_spin_dot:first-child{r:var(--spin-dot-size);--spin-dot-opacity:0.22;animation-delay:0s,0s}'
RD_THEME_SPIN__DOT='rd_spin_dot'
RD_THEME_SPIN__ROOT='rd_spin'
RD_THEME_BUTTON__LOADING='rd_button_loading'
RD_THEME_BUTTON__SPIN='rd_button_spin'
